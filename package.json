{
  "name": "exam-practicing",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db": "docker compose up -d --wait",
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
